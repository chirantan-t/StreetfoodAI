# StreetFoodAI Backend Configuration
APP_NAME=StreetFoodAI
APP_ENV=development
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Model & ML Settings
MODEL_TYPE=mobilenet_v3_large
# Path to trained weights (.pth / .pt), or empty if un-trained weights
MODEL_WEIGHTS_PATH=ml/checkpoints/best_mobilenet_v3_large.pth
CONFIDENCE_THRESHOLD=0.65
UNKNOWN_THRESHOLD=0.50
ENTROPY_THRESHOLD=1.5
DEVICE=cpu

# Database
DATABASE_URL=sqlite:///./streetfood_history.db

# Storage / Paths
NUTRITION_DB_PATH=ml/config/nutrition_db.json
CLASSES_CONFIG_PATH=ml/config/classes.json
RESULTS_DIR=results/evaluations
