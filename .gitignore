# ==============================================================================
# StreetFoodAI .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables
.env
.env.local

# Testing & Linting
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# SQLite Databases & Local Storage
*.sqlite
*.sqlite3
*.db
!test_*.db

# ML Model Checkpoints & Large Weights (>50MB)
*.pth
*.pt
*.onnx
*.bin
models/checkpoints/*
ml/checkpoints/*
!ml/checkpoints/.gitkeep
!ml/checkpoints/README.md
!ml/checkpoints/*_history.json
results/checkpoints/*
!results/checkpoints/.gitkeep

# ML Datasets (keep metadata and sample tests only)
data/raw/*
!data/raw/.gitkeep
!data/raw/sample_test/
data/processed/*
!data/processed/.gitkeep

# Dataset Builder local data caches and images
tools/dataset_builder/data/images/*
!tools/dataset_builder/data/images/.gitkeep
tools/dataset_builder/data/cache/*
!tools/dataset_builder/data/cache/.gitkeep
tools/dataset_builder/data/embeddings/*
!tools/dataset_builder/data/embeddings/.gitkeep

# MLflow Tracking
mlruns/
.mlflow/

# IDE & Operating System
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Frontend & Node
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Results caches
results/cache/
